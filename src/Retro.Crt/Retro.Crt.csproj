<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Retro.Crt</RootNamespace>
    <AssemblyName>Retro.Crt</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>Retro.Crt</PackageId>
    <Version>0.7.0</Version>
    <Authors>Chloe Dream</Authors>
    <Company>Chloe Dream</Company>
    <Description>Pascal CRT-Unit-style console for modern .NET. Tiny, dependency-free, trim- and AOT-clean. Truecolor with NO_COLOR and 16-color fallback.</Description>
    <PackageTags>console;ansi;truecolor;crt;pascal;cli;terminal</PackageTags>
    <PackageProjectUrl>https://github.com/chloe-dream/retro-crt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chloe-dream/retro-crt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) 2026 Chloe Dream</Copyright>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- LibraryImport source-generated P/Invoke stubs require unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Ship XML doc comments in the NuGet package so consumers get
         IntelliSense, and so DocFX can resolve cross-references. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 = "Missing XML comment for publicly visible type or member".
         We document every public surface, but a stray internal-helper or
         overload that gets renamed shouldn't break the build.
         RS0026 = "Do not add multiple overloads with optional parameters" —
         the Banner.Box(string) / Box(string[]) split is intentional
         (different parameter types, both shipped together since v0.1). -->
    <NoWarn>$(NoWarn);1591;RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Retro.Crt.Tests" />
    <InternalsVisibleTo Include="Retro.Crt.Bench" />
    <InternalsVisibleTo Include="Retro.Crt.Tui" />
  </ItemGroup>

  <ItemGroup>
    <!-- Locks the public API. New / removed / changed members must be
         reflected in PublicAPI.Unshipped.txt; releases promote entries
         to PublicAPI.Shipped.txt. Build fails on accidental drift. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
