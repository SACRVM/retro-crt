<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Retro.Crt</RootNamespace>
    <AssemblyName>Retro.Crt</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>Retro.Crt</PackageId>
    <Version>0.2.0</Version>
    <Authors>Chloe Dream</Authors>
    <Company>Chloe Dream</Company>
    <Description>Pascal CRT-Unit-style console for modern .NET. Tiny, dependency-free, trim- and AOT-clean. Truecolor with NO_COLOR and 16-color fallback.</Description>
    <PackageTags>console;ansi;truecolor;crt;pascal;cli;terminal</PackageTags>
    <PackageProjectUrl>https://github.com/chloe-dream/retro-crt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chloe-dream/retro-crt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) 2026 Chloe Dream</Copyright>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- LibraryImport source-generated P/Invoke stubs require unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Retro.Crt.Tests" />
  </ItemGroup>

</Project>
