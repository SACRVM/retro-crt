{
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [ "src/Retro.Crt/Retro.Crt.csproj" ]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "EnumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "exclude": [ "obj/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Retro.Crt",
      "_appTitle": "Retro.Crt — Pascal CRT-Unit-style console for modern .NET",
      "_appLogoPath": "",
      "_appFooter": "Retro.Crt is MIT-licensed. Built with DocFX.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/SACRVM/retro-crt",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://sacrvm.github.io/retro-crt"
    },
    "xref": [],
    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ]
  }
}
