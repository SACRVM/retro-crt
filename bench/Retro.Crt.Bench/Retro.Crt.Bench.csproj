<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Retro.Crt.Bench</RootNamespace>
    <AssemblyName>Retro.Crt.Bench</AssemblyName>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Benchmarks deliberately exercise paths the analyzer doesn't like
         (Console.Out churn, throwaway allocations) — relax warnings here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1859;CA2249;CS1591;CA1305;CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Retro.Crt\Retro.Crt.csproj" />
  </ItemGroup>

</Project>
